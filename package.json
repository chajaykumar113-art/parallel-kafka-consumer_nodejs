{
  "name": "parallel-kafka-consumer",
  "version": "0.0.0",
  "description": "Key-ordered parallel Kafka consumer for Node.js with safe offset commits",
  "keywords": [
    "kafka",
    "kafkajs",
    "consumer",
    "parallel",
    "concurrency",
    "ordering",
    "offset",
    "commit"
  ],
  "author": "ajay kumar ch",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chajaykumar113-art/parallel-kafka-consumer_nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/chajaykumar113-art/parallel-kafka-consumer_nodejs/issues"
  },
  "homepage": "https://github.com/chajaykumar113-art/parallel-kafka-consumer_nodejs#readme",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsup",
    "typecheck": "tsc",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm run build && npm run check:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
