{
  "name": "parallel-kafka-consumer",
  "version": "0.0.0",
  "description": "Key-ordered parallel Kafka consumer for Node.js with safe offset commits",
  "keywords": [
    "kafka",
    "kafkajs",
    "consumer",
    "parallel",
    "concurrency",
    "ordering",
    "offset",
    "commit"
  ],
  "author": "ajay kumar ch",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chajaykumar113-art/parallel-kafka-consumer_nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/chajaykumar113-art/parallel-kafka-consumer_nodejs/issues"
  },
  "homepage": "https://github.com/chajaykumar113-art/parallel-kafka-consumer_nodejs#readme",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsup",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "npm run build && node test/package/smoke.mjs",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "3.10.1",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
